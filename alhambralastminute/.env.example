# --- Stripe (sin estas claves la web arranca en MODO DEMO: el pago se simula) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Secreto del webhook (Stripe Dashboard > Developers > Webhooks, endpoint /webhook)
STRIPE_WEBHOOK_SECRET=

# --- Panel de administración (/admin). Sin contraseña, el panel queda desactivado ---
ADMIN_PASSWORD=

# --- Reglas de reserva ---
# Primer día reservable = hoy + FIRST_DAY_OFFSET (1 = mañana)
FIRST_DAY_OFFSET=1
# Último día reservable = hoy + LAST_DAY_OFFSET
LAST_DAY_OFFSET=29
# Hasta hoy + VISA_MAX_OFFSET se aceptan Visa y Mastercard (retención de 7 días).
# Desde el día siguiente y hasta el final, solo Mastercard (retención ampliada de 30 días).
VISA_MAX_OFFSET=6
# Fechas cerradas, separadas por comas (YYYY-MM-DD)
BLOCKED_DATES=
MAX_GROUP_SIZE=10

# --- Precios en céntimos (PROVISIONALES: ajústalos) ---
CURRENCY=eur
PRICE_ADULT_CENTS=8900
PRICE_CHILD_CENTS=5900
# Niño = edad entre CHILD_MIN_AGE y CHILD_MAX_AGE; por debajo de CHILD_MIN_AGE, gratis
CHILD_MIN_AGE=3
CHILD_MAX_AGE=11

# --- Servidor ---
PORT=3000
# Pon 1 si hay un proxy/CDN delante (Render, Railway, Nginx, Cloudflare...)
TRUST_PROXY=0
DB_PATH=./data/bookings.db
